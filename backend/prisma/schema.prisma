generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:Gopika%40243@localhost:5432/postgres?schema=public"
}

model applications {
  id           BigInt       @id @default(autoincrement())
  applied_at   DateTime?    @db.Timestamp(6)
  resume_text  String?
  status       String?      @db.VarChar(255)
  candidate_id BigInt
  job_id       BigInt
  jobs         jobs         @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk65weib1lru9dkrbto5pv389vi")
  candidates   candidates   @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkg4e16cwk1qrad923bpx4hamdh")
  ats_results  ats_results?
  interviews   interviews[]
}

model ats_results {
  id                       BigInt       @id @default(autoincrement())
  analyzed_at              DateTime?    @db.Timestamp(6)
  candidate_summary        String?
  education_match_score    Float
  experience_match_score   Float
  final_ats_score          Float
  interview_recommendation String?
  keyword_match_score      Float
  missing_skills           String?
  skill_match_score        Float
  strengths                String?
  weaknesses               String?
  format_match_score       Float?       @default(0)
  project_match_score      Float?       @default(0)
  certification_match_score Float?       @default(0)
  missing_keywords         String?
  recommended_certifications String?
  improvement_suggestions  String?
  communication_match_score Float?       @default(0)
  skill_by_skill_scores    String?      @db.Text
  project_scores_breakdown String?      @db.Text
  interview_success_probability Float?   @default(0)
  hiring_success_probability Float?      @default(0)
  weak_skills              String?      @db.Text
  strong_skills            String?      @db.Text
  application_id           BigInt       @unique(map: "uk_l8pr6kdsj4lfqeudlw376qta2")
  applications             applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk3q1q4scjeoy4qlsu33qd5m98u")
}

model candidate_education {
  candidate_id    BigInt
  education_entry String     @db.Text
  candidates      candidates @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk1u4u9ua2ovmpu6nhgywgv0y1o")

  @@id([candidate_id, education_entry])
}

model candidate_experience {
  candidate_id     BigInt
  experience_entry String     @db.Text
  candidates       candidates @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk7rb84nsb3y9d11xrfqblcb7fr")

  @@id([candidate_id, experience_entry])
}

model candidate_skills {
  candidate_id BigInt
  skill        String     @db.VarChar(255)
  candidates   candidates @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkk71gu2subkaxroroxevtc6lu6")

  @@id([candidate_id, skill])
}

model candidates {
  id                   BigInt                 @id @default(autoincrement())
  first_name           String                 @db.VarChar(255)
  last_name            String                 @db.VarChar(255)
  phone                String?                @db.VarChar(255)
  resume_url           String?
  title                String?                @db.VarChar(255)
  user_id              BigInt?                @unique(map: "uk_doi1o7iyehcrqrrrbxjostvv5")
  applications         applications[]
  candidate_education  candidate_education[]
  candidate_experience candidate_experience[]
  candidate_skills     candidate_skills[]
  users                users?                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkme4fkelukmx2s63tlcrft6hio")
  builder_resumes      builder_resumes[]
  chat_conversations   chat_conversations[]
  preparation_progresses preparation_progresses[]
}

model companies {
  id          BigInt  @id @default(autoincrement())
  description String?
  industry    String? @db.VarChar(255)
  location    String? @db.VarChar(255)
  name        String  @db.VarChar(255)
  website     String? @db.VarChar(255)
  user_id     BigInt? @unique(map: "uk_5xg6ed73n32iai9psir68pia9")
  users       users?  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk9l5d0fem75e59uwf9upwuf9du")
  jobs        jobs[]
  chat_conversations chat_conversations[]
}

model job_keywords {
  job_id  BigInt
  keyword String @db.VarChar(255)
  jobs    jobs   @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkl4b1xq220t2885j4mefb8ql8b")

  @@id([job_id, keyword])
}

model job_skills {
  job_id BigInt
  skill  String @db.VarChar(255)
  jobs   jobs   @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk1gb74tysr9vkypwivvvovxq1f")

  @@id([job_id, skill])
}

model jobs {
  id                        BigInt         @id @default(autoincrement())
  created_at                DateTime?      @db.Timestamp(6)
  description               String
  education_required        String?        @db.VarChar(255)
  experience_required_years Int
  location                  String?        @db.VarChar(255)
  requirements              String?
  salary_range              String?        @db.VarChar(255)
  status                    String?        @db.VarChar(255)
  title                     String         @db.VarChar(255)
  company_id                BigInt
  applications              applications[]
  job_keywords              job_keywords[]
  job_skills                job_skills[]
  companies                 companies      @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fkrtmqcrktb6s7xq8djbs2a2war")
}

model users {
  id            BigInt      @id @default(autoincrement())
  email         String      @unique(map: "uk_6dotkott2kjsp8vw4d5m25fb7") @db.VarChar(255)
  password      String      @db.VarChar(255)
  role          String      @db.VarChar(255)
  username      String      @unique(map: "uk_r43af9ap4edm43mmtq01oddj6") @db.VarChar(255)
  candidates    candidates?
  companies     companies?
  notifications notifications[]
  chat_messages chat_messages[]
}

model builder_resumes {
  id             BigInt     @id @default(autoincrement())
  version        Int        @default(1)
  name           String     @db.VarChar(255)
  email          String     @db.VarChar(255)
  phone          String?    @db.VarChar(255)
  linkedin       String?    @db.VarChar(255)
  github         String?    @db.VarChar(255)
  portfolio      String?    @db.VarChar(255)
  summary        String?    @db.Text
  education      String?    @db.Text
  experience     String?    @db.Text
  skills         String?    @db.Text
  projects       String?    @db.Text
  certifications String?    @db.Text
  template       String     @default("Modern") @db.VarChar(100)
  created_at     DateTime?  @default(now()) @db.Timestamp(6)
  updated_at     DateTime?  @default(now()) @db.Timestamp(6)
  candidate_id   BigInt
  candidates     candidates @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model interviews {
  id                BigInt       @id @default(autoincrement())
  interview_date    DateTime     @db.Date
  interview_time    String       @db.VarChar(100)
  interview_mode    String       @db.VarChar(100)
  meeting_link      String?      @db.Text
  office_address    String?      @db.Text
  interview_round   String       @db.VarChar(100)
  status            String       @default("SCHEDULED") @db.VarChar(100)
  reschedule_reason String?      @db.Text
  instructions      String?      @db.Text
  created_at        DateTime?    @default(now()) @db.Timestamp(6)
  updated_at        DateTime?    @default(now()) @db.Timestamp(6)
  application_id    BigInt
  applications      applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  preparation_topics interview_preparation_topics[]
}

model interview_preparation_topics {
  id           BigInt     @id @default(autoincrement())
  interview_id BigInt
  name         String     @db.VarChar(255)
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  interviews   interviews @relation(fields: [interview_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  progress     preparation_progresses[]
}

model notifications {
  id          BigInt    @id @default(autoincrement())
  user_id     BigInt
  text        String    @db.Text
  is_read     Boolean   @default(false)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model chat_conversations {
  id           BigInt       @id @default(autoincrement())
  candidate_id BigInt
  company_id   BigInt
  created_at   DateTime?    @default(now()) @db.Timestamp(6)
  candidates   candidates   @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  companies    companies    @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages     chat_messages[]
}

model chat_messages {
  id              BigInt             @id @default(autoincrement())
  conversation_id BigInt
  sender_id       BigInt
  text            String             @db.Text
  is_read         Boolean            @default(false)
  created_at      DateTime?          @default(now()) @db.Timestamp(6)
  conversation    chat_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender          users              @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model preparation_progresses {
  id           BigInt                       @id @default(autoincrement())
  candidate_id BigInt
  topic_id     BigInt
  mcq_score    Float?
  written_resp String?                      @db.Text
  progress_pct Float                        @default(0)
  completed    Boolean                      @default(false)
  updated_at   DateTime?                    @default(now()) @db.Timestamp(6)
  candidates   candidates                   @relation(fields: [candidate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  topic        interview_preparation_topics @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model mcq_questions {
  id             BigInt  @id @default(autoincrement())
  topic_name     String  @db.VarChar(255)
  question       String  @db.Text
  options        String  @db.Text
  correct_option Int
}

model written_questions {
  id               BigInt  @id @default(autoincrement())
  topic_name       String  @db.VarChar(255)
  question         String  @db.Text
  suggested_answer String? @db.Text
}
